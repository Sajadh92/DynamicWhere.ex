      <Authors>Sajjad H. Al-Khafaji</Authors>
      <Company>Sajjad H. Al-Khafaji</Company>
      <Copyright>Free Forever — Copyright © Sajjad H. Al-Khafaji</Copyright>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <Version>3.4.0</Version>
      <PackageProjectUrl>https://doc.dynamicwhere.com</PackageProjectUrl>
